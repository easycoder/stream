    put 1 into IsCreate


    put `1fr 0.7fr 0.4fr 2.5fr 2.5fr 1fr 1fr 0.6fr 0.6fr 0.5fr 0.5fr 0.5fr` into Grid

    put `display: grid; grid-template-columns: ` cat Grid into RowStyleData
