    put `padding: 0.3em 0.9em; cursor: pointer; border: 0; border-radius: 4px; background: #28a; color: white` into KindSelectedStyle
    put `padding: 0.3em 0.9em; cursor: pointer; border: 0; border-radius: 4px; background: #eee; color: #333` into KindUnselectedStyle

    put `padding: 0.4em 1em; margin-bottom: -2px; border: 1px solid #ccc; border-bottom: 2px solid #28a; border-radius: 4px 4px 0 0; background: #fff; color: #28a; font-weight: bold; cursor: pointer` into TabActiveStyle
    put `padding: 0.4em 1em; margin-bottom: -2px; border: 1px solid transparent; border-bottom: 2px solid transparent; border-radius: 4px 4px 0 0; background: #eee; color: #555; cursor: pointer` into TabInactiveStyle
    put `general` into ActiveFormTab

    put `display: flex; align-items: center; gap: 0.4em; padding: 0.3em 0.4em; border-bottom: 1px solid #eee` into LocRowStyle
    put `flex: 1; min-width: 0; cursor: pointer; padding: 0.2em 0.3em; border-radius: 4px` into LocPickStyle
    put `font-weight: bold` into LocNameStyle
    put `font-size: 0.85em; color: #666; white-space: pre-wrap; word-break: break-word` into LocMetaStyle
    put `padding: 0.2em 0.6em; font-size: 0.8em; cursor: pointer; border: 1px solid #d33; border-radius: 4px; background: #fdd; color: #900; flex-shrink: 0` into LocDelBtnStyle
    put 0 into LocationsLoaded
    set LocNames to array
    set LocPostcodes to array
    set LocDistances to array
    set LocNotes to array
    set LocOrigNames to array

    put `display: flex; align-items: center; gap: 0.4em; padding: 0.3em 0.4em; border-bottom: 1px solid #eee` into ClientRowStyle
    put `flex: 1; min-width: 0; cursor: pointer; padding: 0.2em 0.3em; border-radius: 4px` into ClientPickStyle
    put `font-weight: bold` into ClientNameStyle
    put `font-size: 0.85em; color: #666; white-space: pre-wrap; word-break: break-word` into ClientMetaStyle
    put `padding: 0.2em 0.6em; font-size: 0.8em; cursor: pointer; border: 1px solid #d33; border-radius: 4px; background: #fdd; color: #900; flex-shrink: 0` into ClientDelBtnStyle
    put 0 into ClientsLoaded
    set ClientCompanies to array
    set ClientReps to array
    set ClientPhones to array
    set ClientEmails to array
    set ClientOrigCompanies to array
    set ClientOrigReps to array

    put `January,February,March,April,May,June,July,August,September,October,November,December` into MonthNames
    split MonthNames on `,`


    on click LoginButton gosub OnLogin
    on click AddButton gosub OnAdd
    on click SaveBtn gosub OnSave
    on click CancelBtn gosub OnCancel
    on click DeleteBtn gosub OnDelete
    on click KindServiceBtn gosub SelectKindService
