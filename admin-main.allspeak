    get SavedCreds from storage as `admin.credentials`
    if SavedCreds is not empty
    begin
        put json SavedCreds into ResponseObj
        put property `user` of ResponseObj into TempStr
        set the content of UserField to TempStr
        put property `pass` of ResponseObj into TempStr
        set the content of PassField to TempStr
        set attribute `checked` of RememberCheckbox to `checked`
        set style `display` of AdminPanel to `none`
        gosub OnLogin
    end
    else
        set style `display` of AdminPanel to `none`
    fork to Heartbeat
    fork to WatchForUploadedDocument
    stop
!! @hash 5690d4df
!!!
!! Login: POST credentials to login.php, on success show the admin panel
!! and load data.
!! Save or clear credentials in browser storage based on the Remember me
!! checkbox so the user can skip the login panel on their next visit.
OnLogin:
    set the content of LoginStatus to ``
    gosub BuildLoginBody
    rest post LoginBody to `login.php` giving ResponseJson on failure
    begin
        set the content of LoginStatus to `Could not reach server.`
        set style `display` of AdminPanel to `none`
        return
    end
    put json ResponseJson into ResponseObj
    put property `status` of ResponseObj into ResponseStatus
    if ResponseStatus is not `ok`
    begin
        set the content of LoginStatus to `Login failed.`
        set style `display` of AdminPanel to `none`
        return
    end
    set style `display` of LoginPanel to `none`
    set style `display` of AdminPanel to `block`
    put attribute `checked` of RememberCheckbox into TempStr
    if TempStr is not empty
    begin
        put `{"user":"` cat the content of UserField into SavedCreds
        put SavedCreds cat `","pass":"` cat the content of PassField into SavedCreds
        put SavedCreds cat `"}` into SavedCreds
        put SavedCreds into storage as `admin.credentials`
    end
    else
        put `` into storage as `admin.credentials`
    gosub Refresh
    return
!! @hash ec85b4e5
!!!
!! Refresh: fetch all bookings from the server and render the table.
!! Pass 1: count rows and discover month boundaries so we can pre-size
!! arrays (AllSpeak's cursor model requires this).
Refresh:
    set the content of LogBody to ``
    set the content of ExportStatus to ``
    gosub TodayString
    put random 999999999 into CacheBuster

    rest get AllBookings from `bookings.php?cb=` cat CacheBuster on failure
    begin
        set the content of LogBody to `Could not load bookings.`
        return
    end
    put json count of AllBookings into BookingCount

    if BookingCount is 0
    begin
        set style `display` of EmptyState to `block`
        set style `display` of LogBody to `none`
        return
    end

    set style `display` of EmptyState to `none`
    set style `display` of LogBody to `block`


    put 0 into I
    put `` into LastFy
    put `` into LastMm
    put 0 into SortCount

    while I is less than BookingCount
    begin
        put element I of AllBookings into Row

        put property `date` of Row into BookingDate
        gosub FyAndMmFromDate

        if EditFyStart is not empty and EditFyStart is not FY
        begin
            add 1 to I
        end
        else
        begin
            if LastMm is not Mm or LastFy is not FY
            begin
                add 1 to SortCount    ! subtotal header
                put FY into LastFy
                put Mm into LastMm
            end

            add 1 to SortCount        ! data row
            add 1 to I
        end
    end

    ! One more for the grand total
    add 1 to SortCount

    put 0 into I
    put `` into LastFy
    put `` into LastMm
    put 0 into GrandMileage
    put 0 into GrandExpense
    put 0 into GrandFees

    ! Pre-pass: calculate grand totals and per-month totals
    put 0 into I
    put 0 into GrandMileage
    put 0 into GrandExpense
    put 0 into GrandFees
    set MonthFyArr to array
    set MonthMmArr to array
    set MonthExpenseArr to array
    set MonthFeesArr to array
    put 0 into MonthCount
    put `` into LastFy
    put `` into LastMm
    put 0 into MonthMileage
    put 0 into MonthExpense
    put 0 into MonthFees
    while I is less than BookingCount
    begin
        put element I of AllBookings into Row
        put property `date` of Row into BookingDate
        gosub FyAndMmFromDate
        if EditFyStart is empty or EditFyStart is FY
        begin
            if LastMm is not Mm or LastFy is not FY
            begin
                if LastMm is not empty
                begin
                    set element MonthCount of MonthFyArr to LastFy
                    set element MonthCount of MonthMmArr to LastMm
                    set element MonthCount of MonthExpenseArr to MonthExpense
                    set element MonthCount of MonthFeesArr to MonthFees
                    add 1 to MonthCount
                end
                put 0 into MonthMileage
                put 0 into MonthExpense
                put 0 into MonthFees
                put FY into LastFy
                put Mm into LastMm
            end
            put property `mileage` of Row into Mileage
            put property `expense` of Row into Expense
            put property `fees` of Row into Fees
            add Mileage to MonthMileage
            add Mileage to GrandMileage
            add Expense to MonthExpense
            add Expense to GrandExpense
            add Fees to MonthFees
            add Fees to GrandFees
        end
        add 1 to I
    end
    ! Store last month's totals
    if LastMm is not empty
    begin
        set element MonthCount of MonthFyArr to LastFy
        set element MonthCount of MonthMmArr to LastMm
        set element MonthCount of MonthExpenseArr to MonthExpense
        set element MonthCount of MonthFeesArr to MonthFees
        add 1 to MonthCount
    end

    ! Emit grand total at the top of the sheet
    gosub EmitGrandTotal

    ! Pass 2: single pass — when month changes, emit pre-computed subtotal,
    ! then emit the row. MonthIdx tracks which month's data to show next.
    put 0 into MonthIdx
    put 0 into I
    put `` into LastFy
    put `` into LastMm
    set the elements of DataRowDivs to BookingCount

    while I is less than BookingCount
    begin
        put element I of AllBookings into Row

        put property `date` of Row into BookingDate
        gosub FyAndMmFromDate

        if EditFyStart is not empty and EditFyStart is not FY
        begin
            add 1 to I
        end
        else
        begin
            if LastMm is not Mm or LastFy is not FY
            begin
                ! Emit this month's subtotal using pre-computed values
                put element MonthIdx of MonthFyArr into TempFy
                put element MonthIdx of MonthMmArr into TempMm
                put element MonthIdx of MonthExpenseArr into MonthExpense
                put element MonthIdx of MonthFeesArr into MonthFees
                put TempFy into LastFy
                put TempMm into LastMm
                gosub EmitSubtotal
                add 1 to MonthIdx
            end

            gosub EmitRow
            add 1 to I
        end
    end

    on click DataRowDivs gosub OnRowClick
    return
!! @hash 77be460a
!!!
!! EmitRow: render one data row from the current record in 'Row'.
EmitRow:
    index DataRowDivs to I
    put property `date` of Row into BookingDate
    put property `time` of Row into BookingTime
    put property `name` of Row into BookingName
    put property `kind` of Row into Kind
    put property `mileage` of Row into Mileage
    put property `expense` of Row into Expense
    put property `fees` of Row into Fees
    put property `paid` of Row into Paid
    put property `invoiced` of Row into Invoiced
    create DataRowDivs in LogBody
    set the style of DataRowDivs to RowStyleData
    put 0 into WarnAmber

    ! Past dates get a light gray background
    if BookingDate is less than TodayStr
        set style `background` of DataRowDivs to `#f0f0f0`

    ! Amber warning: within 3 days, has a stream, and link not sent
    put date BookingDate into BookingStamp
    if BookingStamp is greater than now
    begin
        subtract now from BookingStamp
        if BookingStamp is less than 259200000  ! 3 days in ms
        begin
            put property `dacast_id` of Row into TempStr
            if TempStr is empty
                put property `stream_url` of Row into TempStr
            if TempStr is not empty
            begin
                put property `linkSent` of Row into TempStr
                if TempStr is empty
                    put 1 into WarnAmber
                else
                    put 0 into WarnAmber
            end
            else
                put 0 into WarnAmber
        end
        else
            put 0 into WarnAmber
    end
    else
        put 0 into WarnAmber

    ! Column 1: date
    create CellDiv in DataRowDivs
    set the content of CellDiv to BookingDate

    ! Column 2: time
    create CellDiv in DataRowDivs
    set the content of CellDiv to BookingTime

    ! Column 3: expense flag (💰 only for expense rows)
    create CellDiv in DataRowDivs
    if Kind is `expense`
        set the content of CellDiv to `💰`

    ! Column 4: name
    create CellDiv in DataRowDivs
    if Kind is `expense`
    begin
        put property `name` of Row into BookingName
        if BookingName is empty
            put property `description` of Row into BookingName
        set the content of CellDiv to BookingName
    end
    else
        set the content of CellDiv to BookingName

    ! Column 5: location
    create CellDiv in DataRowDivs
    put property `location` of Row into TempStr
    if TempStr is not empty
        set the content of CellDiv to TempStr

    ! Column 6: contact
    create CellDiv in DataRowDivs
    put property `contact` of Row into TempStr
    set the content of CellDiv to TempStr

    ! Column 7: client
    create CellDiv in DataRowDivs
    put property `client` of Row into BookingClient
    set the content of CellDiv to BookingClient

    ! Column 8: expense
    create CellDiv in DataRowDivs
    set the style of CellDiv to CellRight
    put Expense into MoneyVal
    gosub FormatMoney
    set the content of CellDiv to MoneyStr

    ! Column 9: fees
    create CellDiv in DataRowDivs
    set the style of CellDiv to CellRight
    put Fees into MoneyVal
    gosub FormatMoney
    set the content of CellDiv to MoneyStr

    ! Column 10: link sent check — amber background if warning
    create CellDiv in DataRowDivs
    set style `text-align` of CellDiv to `center`
    if WarnAmber is 1
        set style `background` of CellDiv to `#ffcc66`
    put property `linkSent` of Row into TempStr
    if TempStr is `false`
        put `` into TempStr
    if TempStr is not empty
        set the content of CellDiv to `✓`

    ! Column 11: invoiced check — deep pink if invoiced but not paid
    create CellDiv in DataRowDivs
    set style `text-align` of CellDiv to `center`
    put property `invoiced` of Row into TempStr
    put property `paid` of Row into Paid
    if TempStr is `false`
        put `` into TempStr
    if TempStr is not empty and Paid is not true
        set style `background` of CellDiv to `#ffb3b3`
    if TempStr is not empty
        set the content of CellDiv to `✓`

    ! Column 12: paid check — deep pink if invoiced but not paid
    create CellDiv in DataRowDivs
    set style `text-align` of CellDiv to `center`
    put property `invoiced` of Row into TempStr
    put property `paid` of Row into Paid
    if TempStr is `false`
        put `` into TempStr
    if TempStr is not empty and Paid is not true
        set style `background` of CellDiv to `#ffb3b3`
    if Paid is true
        set the content of CellDiv to `✓`

    add Mileage to MonthMileage
    add Expense to MonthExpense
    add Fees to MonthFees
    add Mileage to GrandMileage
    add Expense to GrandExpense
    add Fees to GrandFees

    ! Store slug in parallel data
    create RowWrappers in LogBody

    return
!! @hash 04677113
!!!
!! OnRowClick: open the edit modal for the clicked row. We read the slug
!! from the AllBookings array at the stored index.
OnRowClick:
    put the index of DataRowDivs into J
    put element J of AllBookings into Row
    put property `slug` of Row into EditSlugOld
    put property `_path` of Row into EditPath
    put 0 into IsCreate
    gosub PopulateForm
    set style `display` of Overlay to `flex`
    return
!! @hash d12bb316
!!!
!! EmitSubtotal: render a monthly subtotal row.
EmitSubtotal:
    if LastFy is empty
        return

    put LastMm into Mo
    if left 1 of Mo is `0`
        put from 1 of Mo into Mo
    subtract 1 from Mo
    index MonthNames to Mo
    put MonthNames into MonthLabel
    put LastFy into Parts
    split Parts on `-`
    index Parts to 0
    put Parts into Yy
    put MonthLabel cat ` ` cat Yy cat ` total` into MonthLabel

    create SubDiv in LogBody
    set the style of SubDiv to RowStyleSub

    create CellDiv in SubDiv
    create CellDiv in SubDiv
    create CellDiv in SubDiv
    create CellDiv in SubDiv
    set the content of CellDiv to MonthLabel
    create CellDiv in SubDiv
    create CellDiv in SubDiv
    create CellDiv in SubDiv

    create CellDiv in SubDiv
    set the style of CellDiv to CellRight
    put MonthExpense into MoneyVal
    gosub FormatMoney
    set the content of CellDiv to MoneyStr

    create CellDiv in SubDiv
    set the style of CellDiv to CellRight
    put MonthFees into MoneyVal
    gosub FormatMoney
    set the content of CellDiv to MoneyStr

    create CellDiv in SubDiv
    create CellDiv in SubDiv
    create CellDiv in SubDiv
    return
!! @hash 5c937da1
!!!
!! EmitGrandTotal: render the grand total row.
EmitGrandTotal:
    create GrandDiv in LogBody
    set the style of GrandDiv to RowStyleGrand

    create CellDiv in GrandDiv
    create CellDiv in GrandDiv
    create CellDiv in GrandDiv
    create CellDiv in GrandDiv
    set the content of CellDiv to `Grand total`
    create CellDiv in GrandDiv
    create CellDiv in GrandDiv
    create CellDiv in GrandDiv

    create CellDiv in GrandDiv
    set the style of CellDiv to CellRight
    put GrandExpense into MoneyVal
    gosub FormatMoney
    set the content of CellDiv to MoneyStr

    create CellDiv in GrandDiv
    set the style of CellDiv to CellRight
    put GrandFees into MoneyVal
    gosub FormatMoney
    set the content of CellDiv to MoneyStr

    create CellDiv in GrandDiv
    create CellDiv in GrandDiv
    create CellDiv in GrandDiv
    return
!! @hash ac90f52d
!!!
!! FormatMoney: convert integer pence to £XX.XX string.
!! MoneyVal carries the value in (e.g. 1998); MoneyStr carries the result
!! out (e.g. "£19.98"). Negative values produce "-£19.98".
!! FormatMoneyInner: helper — TempStr in, MoneyStr out with £ prefix,
!! using from/right/length for correct string splitting.
FormatMoney:
    if MoneyVal is less than 0
    begin
        negate MoneyVal giving TempStr
        gosub FormatMoneyInner
        put `-` cat MoneyStr into MoneyStr
        return
    end
    put MoneyVal into TempStr
    gosub FormatMoneyInner
    return

FormatMoneyInner:
    put TempStr cat `` into MoneyStr
    put the length of MoneyStr into MoneyLen
    if MoneyLen is 1
    begin
        put `£0.0` cat MoneyStr into MoneyStr
        return
    end
    if MoneyLen is 2
    begin
        put `£0.` cat MoneyStr into MoneyStr
        return
    end
    put MoneyLen into MoneyPos
    subtract 2 from MoneyPos
    put from 0 to MoneyPos of MoneyStr into Whole
    put from MoneyPos of MoneyStr into CentsStr
    put `£` cat Whole cat `.` cat CentsStr into MoneyStr
    return
!! @hash ecf392c8
!!!
!! FormatMileage: convert integer tenths to XX.X string.
!! MileageVal carries the value in (e.g. 444); Mi carries the result
!! out (e.g. "44.4"). Zero produces empty string.
FormatMileage:
    if MileageVal is 0
    begin
        put empty into Mi
        return
    end
    put MileageVal cat `` into Mi
    put the length of Mi into MileLen
    if MileLen is 1
    begin
        put `0.` cat Mi into Mi
        return
    end
    put MileLen into MilePos
    subtract 1 from MilePos
    put from 0 to MilePos of Mi into Whole
    put from MilePos of Mi into FracStr
    put Whole cat `.` cat FracStr into Mi
    return
!! @hash 5ff742ce
!!!
!! FyAndMmFromDate: given BookingDate (YYYY-MM-DD), set FY and Mm.
!! UK financial year: April = month 04 is FY start (e.g. 2026-27).
!! FY = "2026-27", Mm = "04" (month number only, no hyphen).
FyAndMmFromDate:
    put left 4 of BookingDate into FY          ! YYYY
    put from 5 of BookingDate into Mm          ! MM-DD (position 5 = month tens digit)
    put left 2 of Mm into Mm                   ! just the MM digits

    if the value of Mm is not less than 4
    begin
        put the value of FY into NextYr
        add 1 to NextYr
        put FY cat `-` cat right 2 of `0` cat NextYr into FY
    end
    else
    begin
        put the value of FY into FY
        subtract 1 from FY
        put the value of FY into NextYr
        add 1 to NextYr
        put FY cat `-` cat right 2 of `0` cat NextYr into FY
    end
    return
!! @hash d124bc39
!!!
!! OnAdd: open the modal in create mode.
OnAdd:
    put 1 into IsCreate
    put `` into EditSlugOld
    put `` into EditPath
    set style `display` of LocationOverlay to `none`
    set style `display` of LocationEditOverlay to `none`
    put 0 into LocationsLoaded
    set style `display` of ClientOverlay to `none`
    set style `display` of ClientEditOverlay to `none`
    put 0 into ClientsLoaded
    set the content of DateInput to ``
    set the content of TimeInput to ``
    set the content of NameInput to ``
    set the content of LocationInput to ``
    set the content of PostcodeInput to ``
    set the content of DistanceInput to ``
    set the content of ContactInput to ``
    set the content of ClientInput to ``
    set the content of ClientEmailInput to ``
    set the content of ClientPhoneInput to ``
    set the content of DacastInput to ``
    set the content of StreamUrlInput to ``
    set the content of RecordingUrlInput to ``
    set attribute `disabled` of RecordingUrlBtn to `disabled`
    set the content of MileageInput to `0`
    set the content of ExpenseInput to `0`
    set the content of FeesInput to `0`
    remove attribute `checked` of LinkSentToggle
    set the content of LinkSentInput to ``
    remove attribute `checked` of InvoicedToggle
    set the content of InvoicedInput to ``
    remove attribute `checked` of PaidInput
    set the content of PaidDateInput to ``
    set the content of TitleField to ``
    set the content of ContactNameInput to ``
    set the content of ContactRelationInput to ``
    set the content of ContactPhoneInput to ``
    set the content of ContactEmailInput to ``
    set the content of RecordingTextInput to `A fully edited tribute video will be available in a few days, to view or download at the discretion of the family. This will include some or all of the following: coverage of the departure, multiple camera angles and closer views of those speaking.

In the meantime, here is a link to a recording of the stream, for those who may have missed it.`
    set the content of NotesInput to ``
    set the content of TributeUrlInput to ``
    set attribute `disabled` of TributeUrlBtn to `disabled`
    set the content of DocumentUrlInput to ``
    set attribute `disabled` of DocumentUrlBtn to `disabled`
    set the content of ModalTitle to `Add booking`
    set style `display` of DeleteBtn to `none`
    set the content of ModalStatus to ``
    put `general` into ActiveFormTab
    gosub SelectKindService
    set style `display` of Overlay to `flex`
    return
!! @hash a62e860f
!!!
!! PopulateForm: fill the modal with the current Row's data.
PopulateForm:
    set the content of ModalTitle to `Edit booking`
    set style `display` of DeleteBtn to `inline-block`
    set style `display` of LocationOverlay to `none`
    set style `display` of LocationEditOverlay to `none`
    put 0 into LocationsLoaded
    set style `display` of ClientOverlay to `none`
    set style `display` of ClientEditOverlay to `none`
    put 0 into ClientsLoaded

    put `general` into ActiveFormTab
    put property `kind` of Row into Kind
    if Kind is `service`
        gosub SelectKindService
    else if Kind is `expense`
        gosub SelectKindExpense
    else
        gosub SelectKindSlideshow

    put property `date` of Row into BookingDate
    set the content of DateInput to BookingDate

    put property `time` of Row into BookingTime
    set the content of TimeInput to BookingTime

    put property `name` of Row into BookingName
    set the content of NameInput to BookingName

    put property `location` of Row into BookingLocation
    set the content of LocationInput to BookingLocation

    put property `postcode` of Row into TempStr
    set the content of PostcodeInput to TempStr

    put property `distance` of Row into TempStr
    set the content of DistanceInput to TempStr

    put property `contact` of Row into TempStr
    set the content of ContactInput to TempStr

    put property `client` of Row into TempStr
    set the content of ClientInput to TempStr

    put property `client_email` of Row into TempStr
    set the content of ClientEmailInput to TempStr

    put property `client_phone` of Row into TempStr
    set the content of ClientPhoneInput to TempStr

    put property `dacast_id` of Row into TempStr
    set the content of DacastInput to TempStr

    put property `stream_url` of Row into TempStr
    set the content of StreamUrlInput to TempStr

    put property `recording_url` of Row into TempStr
    set the content of RecordingUrlInput to TempStr
    if TempStr is not empty
        remove attribute `disabled` of RecordingUrlBtn
    else
        set attribute `disabled` of RecordingUrlBtn to `disabled`

    put property `mileage` of Row into MileageVal
    gosub FormatMileage
    if Mi is empty
        put `0` into Mi
    set the content of MileageInput to Mi

    put property `expense` of Row into MoneyVal
    divide MoneyVal by 100 giving ExpensePounds
    put MoneyVal modulo 100 into ExpensePence
    put ExpensePounds cat `.` into ExpenseDisplay
    if ExpensePence is less than 10
        put `0` cat ExpensePence into ExpensePenceStr
    else
        put ExpensePence into ExpensePenceStr
    set the content of ExpenseInput to ExpenseDisplay cat ExpensePenceStr

    put property `fees` of Row into Fees
    divide Fees by 100 giving FeesPounds
    set the content of FeesInput to FeesPounds

    put property `linkSent` of Row into TempStr
    put TempStr cat `` into TempStr
    if TempStr is `false`
        put `` into TempStr
    set the content of LinkSentInput to TempStr
    if TempStr is not empty
        set attribute `checked` of LinkSentToggle to `yes`
    else
        remove attribute `checked` of LinkSentToggle

    put property `invoiced` of Row into TempStr
    put TempStr cat `` into TempStr
    if TempStr is `false`
        put `` into TempStr
    set the content of InvoicedInput to TempStr
    if TempStr is not empty
        set attribute `checked` of InvoicedToggle to `yes`
    else
        remove attribute `checked` of InvoicedToggle

    put property `paid` of Row into Paid
    put Paid cat `` into Paid
    if Paid is `true`
        set attribute `checked` of PaidInput to `yes`
    else
        remove attribute `checked` of PaidInput

    put property `paidDate` of Row into TempStr
    set the content of PaidDateInput to TempStr

    put property `title` of Row into TempStr
    set the content of TitleField to TempStr

    put property `contact_name` of Row into TempStr
    set the content of ContactNameInput to TempStr

    put property `contact_relation` of Row into TempStr
    set the content of ContactRelationInput to TempStr

    put property `contact_telephone` of Row into TempStr
    set the content of ContactPhoneInput to TempStr

    put property `contact_email` of Row into TempStr
    set the content of ContactEmailInput to TempStr

    put property `recording_text` of Row into TempStr
    set the content of RecordingTextInput to TempStr

    put property `notes` of Row into TempStr
    set the content of NotesInput to TempStr

    put property `tribute_url` of Row into TempStr
    set the content of TributeUrlInput to TempStr
    if TempStr is not empty
        remove attribute `disabled` of TributeUrlBtn
    else
        set attribute `disabled` of TributeUrlBtn to `disabled`

    put property `document_url` of Row into TempStr
    set the content of DocumentUrlInput to TempStr
    if TempStr is not empty
        remove attribute `disabled` of DocumentUrlBtn
    else
        set attribute `disabled` of DocumentUrlBtn to `disabled`

    return
!! @hash 478ce256
!!!
!! Kind selection: show the sections each kind needs and relabel the shared Name field.
!!
!! An expense has no deceased name: that field carries the purchased item's description, so the label and placeholder switch to Item / Description.
!!
!! Postcode and Distance are never shown in the main form — the location picker fills them behind the scenes — so their rows stay hidden for every kind and are not part of these toggles.
!!
!! Each selector finishes by calling SyncTabsToKind, which hides any form tab the kind leaves blank — an expense has no Contacts fields, a slideshow has no Data fields — so a tab is never an empty page.
SelectKindService:
    put `service` into Kind
    set the style of KindServiceBtn to KindSelectedStyle
    set the style of KindExpenseBtn to KindUnselectedStyle
    set the style of KindSlideshowBtn to KindUnselectedStyle
    set the content of NameLabel to `Name / Deceased`
    set attribute `placeholder` of NameInput to `Full name`
    set style `display` of NameInput to `inline-block`
    set style `display` of LocationInput to `inline-block`
    set style `display` of ContactInput to `inline-block`
    set style `display` of ClientInput to `inline-block`
    set style `display` of ClientEmailInput to `inline-block`
    set style `display` of ClientPhoneInput to `inline-block`
    set style `display` of DacastInput to `inline-block`
    set style `display` of StreamUrlInput to `inline-block`
    set style `display` of TitleField to `inline-block`
    set style `display` of ContactNameInput to `inline-block`
    set style `display` of ContactRelationInput to `inline-block`
    set style `display` of ContactPhoneInput to `inline-block`
    set style `display` of ContactEmailInput to `inline-block`
    set style `display` of RecordingTextInput to `inline-block`
    set style `display` of NotesInput to `inline-block`
    set style `display` of TributeUrlInput to `inline-block`
    set style `display` of DocumentUrlInput to `inline-block`
    ! Show all rows for Service variant
    set style `display` of LocationRow to `flex`
    set style `display` of ContactRow to `flex`
    set style `display` of ClientRow to `flex`
    set style `display` of ClientEmailRow to `flex`
    set style `display` of ClientPhoneRow to `flex`
    set style `display` of DacastRow to `flex`
    set style `display` of StreamUrlRow to `flex`
    set style `display` of MileageRow to `flex`
    set style `display` of FeesRow to `flex`
    set style `display` of LinkSentRow to `flex`
    set style `display` of InvoicedRow to `flex`
    set style `display` of PaidRow to `flex`
    set style `display` of TitleRow to `flex`
    set style `display` of ContactNameRow to `flex`
    set style `display` of ContactRelationRow to `flex`
    set style `display` of ContactPhoneRow to `flex`
    set style `display` of ContactEmailRow to `flex`
    set style `display` of RecordingTextRow to `flex`
    set style `display` of NotesRow to `flex`
    set style `display` of RecordingUrlRow to `flex`
    set style `display` of TributeUrlRow to `flex`
    gosub SyncTabsToKind
    return

SelectKindExpense:
    put `expense` into Kind
    set the style of KindServiceBtn to KindUnselectedStyle
    set the style of KindExpenseBtn to KindSelectedStyle
    set the style of KindSlideshowBtn to KindUnselectedStyle
    set the content of NameLabel to `Item`
    set attribute `placeholder` of NameInput to `Description`
    ! Show only Name, Expense, Document, Notes rows — hide everything else
    set style `display` of NameInput to `inline-block`
    set style `display` of NotesInput to `inline-block`
    set style `display` of DocumentUrlInput to `inline-block`
    set style `display` of LocationRow to `none`
    set style `display` of ContactRow to `none`
    set style `display` of ClientRow to `none`
    set style `display` of ClientEmailRow to `none`
    set style `display` of ClientPhoneRow to `none`
    set style `display` of DacastRow to `none`
    set style `display` of StreamUrlRow to `none`
    set style `display` of MileageRow to `none`
    set style `display` of FeesRow to `none`
    set style `display` of LinkSentRow to `none`
    set style `display` of InvoicedRow to `none`
    set style `display` of PaidRow to `none`
    set style `display` of TitleRow to `none`
    set style `display` of ContactNameRow to `none`
    set style `display` of ContactRelationRow to `none`
    set style `display` of ContactPhoneRow to `none`
    set style `display` of ContactEmailRow to `none`
    set style `display` of RecordingTextRow to `none`
    set style `display` of RecordingUrlRow to `none`
    set style `display` of TributeUrlRow to `none`
    set style `display` of NotesRow to `flex`
    gosub SyncTabsToKind
    return

SelectKindSlideshow:
    put `slideshow` into Kind
    set the style of KindServiceBtn to KindUnselectedStyle
    set the style of KindExpenseBtn to KindUnselectedStyle
    set the style of KindSlideshowBtn to KindSelectedStyle
    set the content of NameLabel to `Name / Deceased`
    set attribute `placeholder` of NameInput to `Full name`
    set style `display` of NameInput to `inline-block`
    set style `display` of LocationInput to `inline-block`
    set style `display` of ContactInput to `inline-block`
    set style `display` of ClientInput to `inline-block`
    set style `display` of ClientEmailInput to `inline-block`
    set style `display` of ClientPhoneInput to `inline-block`
    set style `display` of DacastInput to `none`
    set style `display` of StreamUrlInput to `none`
    set style `display` of TitleField to `none`
    set style `display` of ContactNameInput to `none`
    set style `display` of ContactRelationInput to `none`
    set style `display` of ContactPhoneInput to `none`
    set style `display` of ContactEmailInput to `none`
    set style `display` of RecordingTextInput to `none`
    set style `display` of NotesInput to `inline-block`
    set style `display` of TributeUrlInput to `none`
    set style `display` of DocumentUrlInput to `none`
    ! Slideshow: show Name, Location, Contact, Client, ClientEmail, Notes rows; hide everything else
    set style `display` of LocationRow to `flex`
    set style `display` of ContactRow to `flex`
    set style `display` of ClientRow to `flex`
    set style `display` of ClientEmailRow to `flex`
    set style `display` of ClientPhoneRow to `flex`
    set style `display` of DacastRow to `none`
    set style `display` of StreamUrlRow to `none`
    set style `display` of MileageRow to `none`
    set style `display` of FeesRow to `none`
    set style `display` of LinkSentRow to `none`
    set style `display` of InvoicedRow to `none`
    set style `display` of PaidRow to `none`
    set style `display` of TitleRow to `none`
    set style `display` of ContactNameRow to `none`
    set style `display` of ContactRelationRow to `none`
    set style `display` of ContactPhoneRow to `none`
    set style `display` of ContactEmailRow to `none`
    set style `display` of RecordingTextRow to `none`
    set style `display` of RecordingUrlRow to `none`
    set style `display` of TributeUrlRow to `none`
    set style `display` of NotesRow to `flex`
    gosub SyncTabsToKind
    return
!! @hash b3c4144f
!!!
!! Form tabs: the kind buttons and the Save/Cancel/Delete row belong to the whole modal; only the field panel switches.
!!
!! A tab click names the panel it wants and hands over to ShowActiveTab, which hides the other three so exactly one panel is on screen. Tab styles live in TabActiveStyle/TabInactiveStyle rather than the JSON so the highlight and the panel visibility are decided in one place.
!!
!! SyncTabsToKind runs whenever the kind changes: an expense has no Contacts fields and a slideshow no Data fields, so those tab buttons disappear, and the modal falls back to General if it was sitting on the tab that just went away.
ShowGeneralTab:
    put `general` into ActiveFormTab
    gosub ShowActiveTab
    return

ShowContactsTab:
    put `contacts` into ActiveFormTab
    gosub ShowActiveTab
    return

ShowDataTab:
    put `data` into ActiveFormTab
    gosub ShowActiveTab
    return

ShowTextTab:
    put `text` into ActiveFormTab
    gosub ShowActiveTab
    return

ShowActiveTab:
    set style `display` of GeneralPanel to `none`
    set style `display` of ContactsPanel to `none`
    set style `display` of DataPanel to `none`
    set style `display` of TextPanel to `none`
    set the style of GeneralTabBtn to TabInactiveStyle
    set the style of ContactsTabBtn to TabInactiveStyle
    set the style of DataTabBtn to TabInactiveStyle
    set the style of TextTabBtn to TabInactiveStyle
    if ActiveFormTab is `general`
    begin
        set style `display` of GeneralPanel to `flex`
        set the style of GeneralTabBtn to TabActiveStyle
    end
    if ActiveFormTab is `contacts`
    begin
        set style `display` of ContactsPanel to `flex`
        set the style of ContactsTabBtn to TabActiveStyle
    end
    if ActiveFormTab is `data`
    begin
        set style `display` of DataPanel to `flex`
        set the style of DataTabBtn to TabActiveStyle
    end
    if ActiveFormTab is `text`
    begin
        set style `display` of TextPanel to `flex`
        set the style of TextTabBtn to TabActiveStyle
    end
    ! Keep empty tabs out of sight for the kinds that have no fields for them.
    if Kind is `expense`
        set style `display` of ContactsTabBtn to `none`
    if Kind is `slideshow`
        set style `display` of DataTabBtn to `none`
    return

SyncTabsToKind:
    if Kind is `expense`
    begin
        if ActiveFormTab is `contacts`
            put `general` into ActiveFormTab
    end
    if Kind is `slideshow`
    begin
        if ActiveFormTab is `data`
            put `general` into ActiveFormTab
    end
    gosub ShowActiveTab
    return
!! @hash ab0c004e
!!!
!! Locations: click the read-only Location field to edit the current venue.
!!
!! The editor opens on the saved record matching the booking's Location, or as a new record carrying the current name and hidden postcode/distance. Its footer is Show all, Cancel, Save, Select. Save writes the list and returns to wherever the editor was opened from; Select also writes, then applies Name, Postcode and Distance to the booking and closes the location windows. Show all opens the saved list.
!!
!! The list is staged in memory — LocNames, LocPostcodes, LocDistances and LocNotes — so Delete changes only those arrays until a save posts the whole list. New location opens the editor for a new record; clicking a row opens the editor for that record, and only Delete sits on each row. The venue's own Notes stay with the venue and are sent with every save.
!!
!! The first open fetches locations.php, which builds data/locations.json from the existing booking files if it does not exist yet. A rename is remembered against the name the record was loaded with (LocOrigNames) and sent with the save, which is what lets the server perform the global search/replace across booking files.
OnEditCurrentLocation:
    set the content of LocationEditStatus to ``
    if LocationsLoaded is 0
    begin
        gosub LoadLocations
        if LocationsLoaded is 0
        begin
            set style `display` of LocationOverlay to `flex`
            return
        end
    end

    put the content of LocationInput into LocNameVal
    put trim LocNameVal into LocNameVal
    put lowercase LocNameVal into TempStr2
    put 0 into LocFindIndex
    put 0 into LocFound
    put 0 into I
    while I is less than LocCount
    begin
        put element I of LocNames into TempStr
        put trim TempStr into TempStr
        put lowercase TempStr into TempStr
        if TempStr is TempStr2
        begin
            put I into LocFindIndex
            put 1 into LocFound
        end
        add 1 to I
    end

    put `main` into LocEditOrigin
    if LocFound is 1
    begin
        put LocFindIndex into LocEditIndex
        put 0 into LocEditIsNew
        set the content of LocationEditTitle to `Edit location`
        put element LocEditIndex of LocNames into TempStr
        set the content of LocNameInput to TempStr
        put element LocEditIndex of LocPostcodes into TempStr
        set the content of LocPostcodeInput to TempStr
        put element LocEditIndex of LocDistances into TempStr
        set the content of LocDistanceInput to TempStr
        put element LocEditIndex of LocNotes into TempStr
        set the content of LocNotesInput to TempStr
    end
    else
    begin
        put -1 into LocEditIndex
        put 1 into LocEditIsNew
        set the content of LocationEditTitle to `New location`
        set the content of LocNameInput to LocNameVal
        put the content of PostcodeInput into TempStr
        set the content of LocPostcodeInput to TempStr
        put the content of DistanceInput into TempStr
        set the content of LocDistanceInput to TempStr
        set the content of LocNotesInput to ``
    end
    set the content of LocationEditStatus to ``
    set style `display` of LocationEditOverlay to `flex`
    return

OnLocationShowAll:
    set style `display` of LocationEditOverlay to `none`
    set the content of LocationStatus to ``
    if LocationsLoaded is 0
        gosub LoadLocations
    else
        gosub RenderLocations
    set style `display` of LocationOverlay to `flex`
    return

OnOpenLocations:
    set the content of LocationStatus to ``
    if LocationsLoaded is 0
        gosub LoadLocations
    else
        gosub RenderLocations
    set style `display` of LocationOverlay to `flex`
    return

LoadLocations:
    put random 999999999 into CacheBuster
    rest get LocResponse from `locations.php?cb=` cat CacheBuster on failure
    begin
        put 0 into LocCount
        set LocNames to array
        set LocPostcodes to array
        set LocDistances to array
        set LocNotes to array
        set LocOrigNames to array
        set the elements of LocRowDivs to 0
        set the elements of LocPickDivs to 0
        set the elements of LocNameDivs to 0
        set the elements of LocMetaDivs to 0
        set the elements of LocDelBtns to 0
        set the content of LocationList to ``
        set style `color` of LocationStatus to `#c00`
        set the content of LocationStatus to `Could not load locations.`
        return
    end
    put json count of LocResponse into LocCount
    set LocNames to array
    set LocPostcodes to array
    set LocDistances to array
    set LocNotes to array
    set LocOrigNames to array
    put 0 into I
    while I is less than LocCount
    begin
        put element I of LocResponse into LocItem
        put property `name` of LocItem into TempStr
        set element I of LocNames to TempStr
        set element I of LocOrigNames to TempStr
        put property `postcode` of LocItem into TempStr
        set element I of LocPostcodes to TempStr
        put property `distance` of LocItem into TempStr
        set element I of LocDistances to TempStr
        put property `notes` of LocItem into TempStr
        set element I of LocNotes to TempStr
        add 1 to I
    end
    put 1 into LocationsLoaded
    gosub RenderLocations
    return

RenderLocations:
    set the content of LocationList to ``
    if LocCount is 0
    begin
        set style `color` of LocationStatus to `#666`
        set the content of LocationStatus to `No saved locations yet — use New location to add one.`
        return
    end
    set the content of LocationStatus to ``
    set the elements of LocRowDivs to LocCount
    set the elements of LocPickDivs to LocCount
    set the elements of LocNameDivs to LocCount
    set the elements of LocMetaDivs to LocCount
    set the elements of LocDelBtns to LocCount
    put 0 into I
    while I is less than LocCount
    begin
        index LocRowDivs to I
        create LocRowDivs in LocationList
        set the style of LocRowDivs to LocRowStyle

        index LocPickDivs to I
        create LocPickDivs in LocRowDivs
        set the style of LocPickDivs to LocPickStyle

        index LocNameDivs to I
        create LocNameDivs in LocPickDivs
        set the style of LocNameDivs to LocNameStyle
        put element I of LocNames into TempStr
        set the content of LocNameDivs to TempStr

        index LocMetaDivs to I
        create LocMetaDivs in LocPickDivs
        set the style of LocMetaDivs to LocMetaStyle
        gosub BuildLocMeta

        index LocDelBtns to I
        create LocDelBtns in LocRowDivs
        set the content of LocDelBtns to `Delete`
        set the style of LocDelBtns to LocDelBtnStyle

        add 1 to I
    end
    on click LocPickDivs gosub OnLocationRowClick
    on click LocDelBtns gosub OnLocationDelete
    return

BuildLocMeta:
    put `` into LocMeta
    put element I of LocPostcodes into TempStr
    if TempStr is not empty
        put TempStr into LocMeta
    put element I of LocDistances into TempStr
    if TempStr is not empty
    begin
        if LocMeta is not empty
            put LocMeta cat ` • ` into LocMeta
        put LocMeta cat TempStr cat ` miles` into LocMeta
    end
    put element I of LocNotes into TempStr
    if TempStr is not empty
    begin
        if LocMeta is not empty
            put LocMeta cat ` • ` into LocMeta
        put LocMeta cat TempStr into LocMeta
    end
    set the content of LocMetaDivs to LocMeta
    return

OnLocationRowClick:
    put the index of LocPickDivs into LocEditIndex
    gosub OnLocationEdit
    return

OnLocationNew:
    put `list` into LocEditOrigin
    put -1 into LocEditIndex
    put 1 into LocEditIsNew
    set the content of LocationEditTitle to `New location`
    set the content of LocNameInput to ``
    set the content of LocPostcodeInput to ``
    set the content of LocDistanceInput to ``
    set the content of LocNotesInput to ``
    set the content of LocationEditStatus to ``
    set style `display` of LocationEditOverlay to `flex`
    return

OnLocationEdit:
    put `list` into LocEditOrigin
    put element LocEditIndex of LocNames into LocNameVal
    if LocNameVal is empty
    begin
        gosub OnLocationNew
        return
    end
    put 0 into LocEditIsNew
    set the content of LocationEditTitle to `Edit location`
    set the content of LocNameInput to LocNameVal
    put element LocEditIndex of LocPostcodes into TempStr
    set the content of LocPostcodeInput to TempStr
    put element LocEditIndex of LocDistances into TempStr
    set the content of LocDistanceInput to TempStr
    put element LocEditIndex of LocNotes into TempStr
    set the content of LocNotesInput to TempStr
    set the content of LocationEditStatus to ``
    set style `display` of LocationEditOverlay to `flex`
    return

OnCloseLocationEditor:
    set style `display` of LocationEditOverlay to `none`
    return

OnSaveLocationRecord:
    gosub StageLocationRecord
    if LocRecordOK is 0
        return
    set style `color` of LocationEditStatus to `#555`
    set the content of LocationEditStatus to `Saving...`
    gosub SaveLocationData
    if LocSaveStatus is not `ok`
    begin
        gosub ShowLocationSaveError
        return
    end
    gosub RebaseLocationNames
    if LocRenamed is greater than 0
        gosub Refresh
    set the content of LocationEditStatus to ``
    set style `display` of LocationEditOverlay to `none`
    if LocEditOrigin is `list`
    begin
        gosub RenderLocations
        set style `display` of LocationOverlay to `flex`
    end
    return

OnSelectLocationRecord:
    gosub StageLocationRecord
    if LocRecordOK is 0
        return
    set style `color` of LocationEditStatus to `#555`
    set the content of LocationEditStatus to `Saving...`
    gosub SaveLocationData
    if LocSaveStatus is not `ok`
    begin
        gosub ShowLocationSaveError
        return
    end
    gosub RebaseLocationNames
    set the content of LocationInput to LocNameVal
    set the content of PostcodeInput to LocPostcodeVal
    set the content of DistanceInput to LocDistanceVal
    set the content of LocationEditStatus to ``
    set style `display` of LocationEditOverlay to `none`
    set style `display` of LocationOverlay to `none`
    if LocRenamed is greater than 0
        gosub Refresh
    return

StageLocationRecord:
    put 1 into LocRecordOK
    put the content of LocNameInput into LocNameVal
    put trim LocNameVal into LocNameVal
    if LocNameVal is empty
    begin
        set the content of LocationEditStatus to `Name is required.`
        put 0 into LocRecordOK
        return
    end
    put the content of LocPostcodeInput into LocPostcodeVal
    put trim LocPostcodeVal into LocPostcodeVal
    put the content of LocDistanceInput into LocDistanceVal
    put trim LocDistanceVal into LocDistanceVal
    put the content of LocNotesInput into LocNotesVal

    put trim LocNameVal into TempStr2
    put lowercase TempStr2 into TempStr2
    put 0 into LocDuplicate
    put 0 into I
    while I is less than LocCount
    begin
        if I is not LocEditIndex
        begin
            put element I of LocNames into TempStr
            put trim TempStr into TempStr
            put lowercase TempStr into TempStr
            if TempStr is TempStr2
                put 1 into LocDuplicate
        end
        add 1 to I
    end
    if LocDuplicate is 1
    begin
        set the content of LocationEditStatus to `Another location already has that name.`
        put 0 into LocRecordOK
        return
    end

    if LocEditIsNew is 1
    begin
        put LocCount into J
        add 1 to LocCount
        set element J of LocNames to LocNameVal
        set element J of LocPostcodes to LocPostcodeVal
        set element J of LocDistances to LocDistanceVal
        set element J of LocNotes to LocNotesVal
        set element J of LocOrigNames to ``
        put J into LocEditIndex
        put 0 into LocEditIsNew
    end
    else
    begin
        set element LocEditIndex of LocNames to LocNameVal
        set element LocEditIndex of LocPostcodes to LocPostcodeVal
        set element LocEditIndex of LocDistances to LocDistanceVal
        set element LocEditIndex of LocNotes to LocNotesVal
    end
    set the content of LocationEditStatus to ``
    return

RebaseLocationNames:
    put 0 into I
    while I is less than LocCount
    begin
        put element I of LocNames into TempStr
        set element I of LocOrigNames to TempStr
        add 1 to I
    end
    return

ShowLocationSaveError:
    set style `color` of LocationEditStatus to `#c00`
    if LocSaveStatus is not empty
        set the content of LocationEditStatus to `Save failed: ` cat LocSaveStatus
    else if SessionState is `expired`
        set the content of LocationEditStatus to `Save failed — session expired, please sign in again.`
    else if SessionState is `valid`
        set the content of LocationEditStatus to `Save failed — the server rejected the save.`
    else
        set the content of LocationEditStatus to `Save failed — could not reach server.`
    return

OnLocationDelete:
    put the index of LocDelBtns into LocDeleteIndex
    confirm `Delete this location? Bookings already using it will keep the name.` gosub DoLocationDelete
    return

DoLocationDelete:
    put LocDeleteIndex into J
    put J into I
    add 1 to I
    while I is less than LocCount
    begin
        put element I of LocNames into LocNameVal
        put element I of LocPostcodes into LocPostcodeVal
        put element I of LocDistances into LocDistanceVal
        put element I of LocNotes into LocNotesVal
        put element I of LocOrigNames into LocFrom
        subtract 1 from I
        set element I of LocNames to LocNameVal
        set element I of LocPostcodes to LocPostcodeVal
        set element I of LocDistances to LocDistanceVal
        set element I of LocNotes to LocNotesVal
        set element I of LocOrigNames to LocFrom
        add 1 to I
        add 1 to I
    end
    subtract 1 from LocCount
    gosub RenderLocations
    return

OnCloseLocations:
    set style `display` of LocationEditOverlay to `none`
    set style `display` of LocationOverlay to `none`
    put 0 into LocationsLoaded
    return

OnSaveLocations:
    set style `color` of LocationStatus to `#555`
    set the content of LocationStatus to `Saving...`
    gosub SaveLocationData
    if LocSaveStatus is `ok`
    begin
        gosub RebaseLocationNames
        if LocRenamed is greater than 0
            gosub Refresh
        set style `color` of LocationStatus to `#080`
        set the content of LocationStatus to `Saved ✓`
        wait 1 second
        set the content of LocationStatus to ``
        set style `display` of LocationOverlay to `none`
        return
    end

    set style `color` of LocationStatus to `#c00`
    if LocSaveStatus is not empty
        set the content of LocationStatus to `Save failed: ` cat LocSaveStatus
    else if SessionState is `expired`
        set the content of LocationStatus to `Save failed — session expired, please sign in again.`
    else if SessionState is `valid`
        set the content of LocationStatus to `Save failed — the server rejected the save.`
    else
        set the content of LocationStatus to `Save failed — could not reach server.`
    return

BuildLocationsBody:
    put `{"locations":[` into LocBody
    put 0 into I
    while I is less than LocCount
    begin
        if I is greater than 0
            put LocBody cat `,` into LocBody
        put LocBody cat `{"name":"` into LocBody
        put element I of LocNames into TempStr2
        gosub AppendLocString
        put LocBody cat `","postcode":"` into LocBody
        put element I of LocPostcodes into TempStr2
        gosub AppendLocString
        put LocBody cat `","distance":"` into LocBody
        put element I of LocDistances into TempStr2
        gosub AppendLocString
        put LocBody cat `","notes":"` into LocBody
        put element I of LocNotes into TempStr2
        gosub AppendLocString
        put LocBody cat `"}` into LocBody
        add 1 to I
    end
    put LocBody cat `],"renames":[` into LocBody
    put 0 into I
    put 0 into LocRenameCount
    while I is less than LocCount
    begin
        put element I of LocOrigNames into LocFrom
        put element I of LocNames into LocTo
        if LocFrom is not empty and LocFrom is not LocTo
        begin
            if LocRenameCount is greater than 0
                put LocBody cat `,` into LocBody
            add 1 to LocRenameCount
            put LocBody cat `{"from":"` into LocBody
            put LocFrom into TempStr2
            gosub AppendLocString
            put LocBody cat `","to":"` into LocBody
            put LocTo into TempStr2
            gosub AppendLocString
            put LocBody cat `"}` into LocBody

            ! Keep the booking being edited in step with a renamed venue.
            put the content of LocationInput into LocCompare
            put trim LocCompare into LocCompare
            put lowercase LocCompare into LocCompare
            put trim LocFrom into TempStr
            put lowercase TempStr into TempStr
            if LocCompare is TempStr
                set the content of LocationInput to LocTo
        end
        add 1 to I
    end
    put LocBody cat `]}` into LocBody
    return

SaveLocationData:
    gosub BuildLocationsBody
    gosub PostLocations
    if LocSaveFailed is not empty
    begin
        gosub CheckSession
        if SessionState is `expired`
        begin
            gosub RecoverSession
            if SessionRecovered is not empty
                gosub PostLocations
        end
    end
    return

PostLocations:
    put `` into LocSaveStatus
    put `` into LocSaveFailed
    put 0 into LocRenamed
    rest post LocBody to `locations.php` giving LocResponseJson on failure
    begin
        put `yes` into LocSaveFailed
        return
    end
    put json LocResponseJson into LocResponseObj
    put property `status` of LocResponseObj into LocSaveStatus
    put property `renamed` of LocResponseObj into LocRenamed
    return

AppendLocString:
    gosub EscapeJson
    put LocBody cat TempStr2 into LocBody
    return

EscapeJson:
    put TempStr2 cat `` into TempOrig
    put `` into TempStr2
    put 0 into J
    put the length of TempOrig into SortK
    while J is less than SortK
    begin
        put left 1 of from J of TempOrig into Ch
        if Ch is `\`
            put TempStr2 cat `\\` into TempStr2
        else if Ch is `"`
            put TempStr2 cat `\"` into TempStr2
        else if Ch is newline
            put TempStr2 cat `\n` into TempStr2
        else
            put TempStr2 cat Ch into TempStr2
        add 1 to J
    end
    return
!! @hash 62775541
!!!
!! Clients: click any read-only client field to edit the current client.
!!
!! The editor opens on the saved record matching the booking's company and rep, or as a new client carrying the current company, rep, phone and email. Its footer is Show all, Cancel, Save, Select. Save writes the list and returns to wherever the editor was opened from; Select also writes, then applies company, rep, phone and email to the booking and closes the client windows. Show all opens the saved list.
!!
!! The list is staged in memory — ClientCompanies, ClientReps, ClientPhones, ClientEmails and the original key pair — so Delete changes only those arrays until a save posts the whole list. New client opens the editor for a new record; clicking a row opens the editor for that record, and only Delete sits on each row. No client clears the four fields and closes the window.
!!
!! Because company and rep form the key, a change to either is remembered against the original pair and sent with the save; the server applies that pair change to every booking that used it. Phone and email edits affect the client record and future picks, not historic bookings.
OnEditCurrentClient:
    set the content of ClientEditStatus to ``
    if ClientsLoaded is 0
    begin
        gosub LoadClients
        if ClientsLoaded is 0
        begin
            set style `display` of ClientOverlay to `flex`
            return
        end
    end

    put the content of ContactInput into ClientRecRepVal
    put trim ClientRecRepVal into ClientRecRepVal
    put the content of ClientInput into ClientRecCompanyVal
    put trim ClientRecCompanyVal into ClientRecCompanyVal
    put lowercase ClientRecCompanyVal into ClientKeyA
    put lowercase ClientRecRepVal into ClientKeyB
    put 0 into ClientFindIndex
    put 0 into ClientFound
    put 0 into I
    while I is less than ClientCount
    begin
        put element I of ClientCompanies into TempStr
        put trim TempStr into TempStr
        put lowercase TempStr into TempStr
        if TempStr is ClientKeyA
        begin
            put element I of ClientReps into TempStr
            put trim TempStr into TempStr
            put lowercase TempStr into TempStr
            if TempStr is ClientKeyB
            begin
                put I into ClientFindIndex
                put 1 into ClientFound
            end
        end
        add 1 to I
    end

    put `main` into ClientEditOrigin
    if ClientFound is 1
    begin
        put ClientFindIndex into ClientEditIndex
        put 0 into ClientEditIsNew
        set the content of ClientEditTitle to `Edit client`
        set the content of ClientRecCompanyInput to ClientRecCompanyVal
        set the content of ClientRecRepInput to ClientRecRepVal
        put element ClientEditIndex of ClientPhones into TempStr
        set the content of ClientRecPhoneInput to TempStr
        put element ClientEditIndex of ClientEmails into TempStr
        set the content of ClientRecEmailInput to TempStr
    end
    else
    begin
        put -1 into ClientEditIndex
        put 1 into ClientEditIsNew
        set the content of ClientEditTitle to `New client`
        set the content of ClientRecCompanyInput to ClientRecCompanyVal
        set the content of ClientRecRepInput to ClientRecRepVal
        put the content of ClientPhoneInput into TempStr
        set the content of ClientRecPhoneInput to TempStr
        put the content of ClientEmailInput into TempStr
        set the content of ClientRecEmailInput to TempStr
    end
    set the content of ClientEditStatus to ``
    set style `display` of ClientEditOverlay to `flex`
    return

OnClientShowAll:
    set style `display` of ClientEditOverlay to `none`
    set the content of ClientStatus to ``
    if ClientsLoaded is 0
        gosub LoadClients
    else
        gosub RenderClients
    set style `display` of ClientOverlay to `flex`
    return

OnOpenClients:
    set style `display` of LocationOverlay to `none`
    set style `display` of LocationEditOverlay to `none`
    set the content of ClientStatus to ``
    if ClientsLoaded is 0
        gosub LoadClients
    else
        gosub RenderClients
    set style `display` of ClientOverlay to `flex`
    return

LoadClients:
    put random 999999999 into CacheBuster
    rest get ClientResponse from `clients.php?cb=` cat CacheBuster on failure
    begin
        put 0 into ClientCount
        set ClientCompanies to array
        set ClientReps to array
        set ClientPhones to array
        set ClientEmails to array
        set ClientOrigCompanies to array
        set ClientOrigReps to array
        set the elements of ClientRowDivs to 0
        set the elements of ClientPickDivs to 0
        set the elements of ClientNameDivs to 0
        set the elements of ClientMetaDivs to 0
        set the elements of ClientDelBtns to 0
        set the content of ClientList to ``
        set style `color` of ClientStatus to `#c00`
        set the content of ClientStatus to `Could not load clients.`
        return
    end
    put json count of ClientResponse into ClientCount
    set ClientCompanies to array
    set ClientReps to array
    set ClientPhones to array
    set ClientEmails to array
    set ClientOrigCompanies to array
    set ClientOrigReps to array
    put 0 into I
    while I is less than ClientCount
    begin
        put element I of ClientResponse into ClientItem
        put property `company` of ClientItem into TempStr
        set element I of ClientCompanies to TempStr
        set element I of ClientOrigCompanies to TempStr
        put property `rep` of ClientItem into TempStr
        set element I of ClientReps to TempStr
        set element I of ClientOrigReps to TempStr
        put property `phone` of ClientItem into TempStr
        set element I of ClientPhones to TempStr
        put property `email` of ClientItem into TempStr
        set element I of ClientEmails to TempStr
        add 1 to I
    end
    put 1 into ClientsLoaded
    gosub RenderClients
    return

RenderClients:
    set the content of ClientList to ``
    if ClientCount is 0
    begin
        set style `color` of ClientStatus to `#666`
        set the content of ClientStatus to `No saved clients yet — use New client to add one.`
        return
    end
    set the content of ClientStatus to ``
    set the elements of ClientRowDivs to ClientCount
    set the elements of ClientPickDivs to ClientCount
    set the elements of ClientNameDivs to ClientCount
    set the elements of ClientMetaDivs to ClientCount
    set the elements of ClientDelBtns to ClientCount
    put 0 into I
    while I is less than ClientCount
    begin
        index ClientRowDivs to I
        create ClientRowDivs in ClientList
        set the style of ClientRowDivs to ClientRowStyle

        index ClientPickDivs to I
        create ClientPickDivs in ClientRowDivs
        set the style of ClientPickDivs to ClientPickStyle

        index ClientNameDivs to I
        create ClientNameDivs in ClientPickDivs
        set the style of ClientNameDivs to ClientNameStyle
        put element I of ClientCompanies into TempStr
        set the content of ClientNameDivs to TempStr

        index ClientMetaDivs to I
        create ClientMetaDivs in ClientPickDivs
        set the style of ClientMetaDivs to ClientMetaStyle
        gosub BuildClientMeta

        index ClientDelBtns to I
        create ClientDelBtns in ClientRowDivs
        set the content of ClientDelBtns to `Delete`
        set the style of ClientDelBtns to ClientDelBtnStyle

        add 1 to I
    end
    on click ClientPickDivs gosub OnClientRowClick
    on click ClientDelBtns gosub OnClientDelete
    return

BuildClientMeta:
    put `` into ClientMeta
    put element I of ClientReps into TempStr
    if TempStr is not empty
        put TempStr into ClientMeta
    put element I of ClientPhones into TempStr
    if TempStr is not empty
    begin
        if ClientMeta is not empty
            put ClientMeta cat ` • ` into ClientMeta
        put ClientMeta cat TempStr into ClientMeta
    end
    put element I of ClientEmails into TempStr
    if TempStr is not empty
    begin
        if ClientMeta is not empty
            put ClientMeta cat ` • ` into ClientMeta
        put ClientMeta cat TempStr into ClientMeta
    end
    set the content of ClientMetaDivs to ClientMeta
    return

OnClientRowClick:
    put the index of ClientPickDivs into ClientEditIndex
    gosub OnClientEdit
    return

OnClientNew:
    put `list` into ClientEditOrigin
    put -1 into ClientEditIndex
    put 1 into ClientEditIsNew
    set the content of ClientEditTitle to `New client`
    set the content of ClientRecCompanyInput to ``
    set the content of ClientRecRepInput to ``
    set the content of ClientRecPhoneInput to ``
    set the content of ClientRecEmailInput to ``
    set the content of ClientEditStatus to ``
    set style `display` of ClientEditOverlay to `flex`
    return

OnClientNone:
    set the content of ClientInput to ``
    set the content of ContactInput to ``
    set the content of ClientPhoneInput to ``
    set the content of ClientEmailInput to ``
    set style `display` of ClientEditOverlay to `none`
    set style `display` of ClientOverlay to `none`
    return

OnClientEdit:
    put `list` into ClientEditOrigin
    put element ClientEditIndex of ClientCompanies into ClientRecCompanyVal
    put element ClientEditIndex of ClientReps into ClientRecRepVal
    if ClientRecCompanyVal is empty and ClientRecRepVal is empty
    begin
        gosub OnClientNew
        return
    end
    put 0 into ClientEditIsNew
    set the content of ClientEditTitle to `Edit client`
    set the content of ClientRecCompanyInput to ClientRecCompanyVal
    set the content of ClientRecRepInput to ClientRecRepVal
    put element ClientEditIndex of ClientPhones into TempStr
    set the content of ClientRecPhoneInput to TempStr
    put element ClientEditIndex of ClientEmails into TempStr
    set the content of ClientRecEmailInput to TempStr
    set the content of ClientEditStatus to ``
    set style `display` of ClientEditOverlay to `flex`
    return

OnCloseClientEditor:
    set style `display` of ClientEditOverlay to `none`
    return

OnSaveClientRecord:
    gosub StageClientRecord
    if ClientRecordOK is 0
        return
    set style `color` of ClientEditStatus to `#555`
    set the content of ClientEditStatus to `Saving...`
    gosub SaveClientData
    if ClientSaveStatus is not `ok`
    begin
        gosub ShowClientSaveError
        return
    end
    gosub RebaseClientKeys
    if ClientRenamed is greater than 0
        gosub Refresh
    set the content of ClientEditStatus to ``
    set style `display` of ClientEditOverlay to `none`
    if ClientEditOrigin is `list`
    begin
        gosub RenderClients
        set style `display` of ClientOverlay to `flex`
    end
    return

OnSelectClientRecord:
    gosub StageClientRecord
    if ClientRecordOK is 0
        return
    set style `color` of ClientEditStatus to `#555`
    set the content of ClientEditStatus to `Saving...`
    gosub SaveClientData
    if ClientSaveStatus is not `ok`
    begin
        gosub ShowClientSaveError
        return
    end
    gosub RebaseClientKeys
    set the content of ClientInput to ClientRecCompanyVal
    set the content of ContactInput to ClientRecRepVal
    set the content of ClientPhoneInput to ClientRecPhoneVal
    set the content of ClientEmailInput to ClientRecEmailVal
    set the content of ClientEditStatus to ``
    set style `display` of ClientEditOverlay to `none`
    set style `display` of ClientOverlay to `none`
    if ClientRenamed is greater than 0
        gosub Refresh
    return

StageClientRecord:
    put 1 into ClientRecordOK
    put the content of ClientRecCompanyInput into ClientRecCompanyVal
    put trim ClientRecCompanyVal into ClientRecCompanyVal
    put the content of ClientRecRepInput into ClientRecRepVal
    put trim ClientRecRepVal into ClientRecRepVal
    put the content of ClientRecPhoneInput into ClientRecPhoneVal
    put trim ClientRecPhoneVal into ClientRecPhoneVal
    put the content of ClientRecEmailInput into ClientRecEmailVal
    put trim ClientRecEmailVal into ClientRecEmailVal
    if ClientRecCompanyVal is empty and ClientRecRepVal is empty
    begin
        set the content of ClientEditStatus to `A client needs a company or a rep.`
        put 0 into ClientRecordOK
        return
    end

    put lowercase ClientRecCompanyVal into ClientKeyA
    put lowercase ClientRecRepVal into ClientKeyB
    put 0 into ClientDuplicate
    put 0 into I
    while I is less than ClientCount
    begin
        if I is not ClientEditIndex
        begin
            put element I of ClientCompanies into TempStr
            put trim TempStr into TempStr
            put lowercase TempStr into TempStr
            if TempStr is ClientKeyA
            begin
                put element I of ClientReps into TempStr
                put trim TempStr into TempStr
                put lowercase TempStr into TempStr
                if TempStr is ClientKeyB
                    put 1 into ClientDuplicate
            end
        end
        add 1 to I
    end
    if ClientDuplicate is 1
    begin
        set the content of ClientEditStatus to `Another client already has that company and rep.`
        put 0 into ClientRecordOK
        return
    end

    if ClientEditIsNew is 1
    begin
        put ClientCount into J
        add 1 to ClientCount
        set element J of ClientCompanies to ClientRecCompanyVal
        set element J of ClientReps to ClientRecRepVal
        set element J of ClientPhones to ClientRecPhoneVal
        set element J of ClientEmails to ClientRecEmailVal
        set element J of ClientOrigCompanies to ``
        set element J of ClientOrigReps to ``
        put J into ClientEditIndex
        put 0 into ClientEditIsNew
    end
    else
    begin
        set element ClientEditIndex of ClientCompanies to ClientRecCompanyVal
        set element ClientEditIndex of ClientReps to ClientRecRepVal
        set element ClientEditIndex of ClientPhones to ClientRecPhoneVal
        set element ClientEditIndex of ClientEmails to ClientRecEmailVal
    end
    set the content of ClientEditStatus to ``
    return

RebaseClientKeys:
    put 0 into I
    while I is less than ClientCount
    begin
        put element I of ClientCompanies into TempStr
        set element I of ClientOrigCompanies to TempStr
        put element I of ClientReps into TempStr
        set element I of ClientOrigReps to TempStr
        add 1 to I
    end
    return

ShowClientSaveError:
    set style `color` of ClientEditStatus to `#c00`
    if ClientSaveStatus is not empty
        set the content of ClientEditStatus to `Save failed: ` cat ClientSaveStatus
    else if SessionState is `expired`
        set the content of ClientEditStatus to `Save failed — session expired, please sign in again.`
    else if SessionState is `valid`
        set the content of ClientEditStatus to `Save failed — the server rejected the save.`
    else
        set the content of ClientEditStatus to `Save failed — could not reach server.`
    return

OnClientDelete:
    put the index of ClientDelBtns into ClientDeleteIndex
    confirm `Delete this client? Bookings already using it will keep the name.` gosub DoClientDelete
    return

DoClientDelete:
    put ClientDeleteIndex into J
    put J into I
    add 1 to I
    while I is less than ClientCount
    begin
        put element I of ClientCompanies into ClientRecCompanyVal
        put element I of ClientReps into ClientRecRepVal
        put element I of ClientPhones into ClientRecPhoneVal
        put element I of ClientEmails into ClientRecEmailVal
        put element I of ClientOrigCompanies into ClientFromCompany
        put element I of ClientOrigReps into ClientFromRep
        subtract 1 from I
        set element I of ClientCompanies to ClientRecCompanyVal
        set element I of ClientReps to ClientRecRepVal
        set element I of ClientPhones to ClientRecPhoneVal
        set element I of ClientEmails to ClientRecEmailVal
        set element I of ClientOrigCompanies to ClientFromCompany
        set element I of ClientOrigReps to ClientFromRep
        add 1 to I
        add 1 to I
    end
    subtract 1 from ClientCount
    gosub RenderClients
    return

OnCloseClients:
    set style `display` of ClientEditOverlay to `none`
    set style `display` of ClientOverlay to `none`
    put 0 into ClientsLoaded
    return

OnSaveClients:
    set style `color` of ClientStatus to `#555`
    set the content of ClientStatus to `Saving...`
    gosub SaveClientData
    if ClientSaveStatus is `ok`
    begin
        gosub RebaseClientKeys
        if ClientRenamed is greater than 0
            gosub Refresh
        set style `color` of ClientStatus to `#080`
        set the content of ClientStatus to `Saved ✓`
        wait 1 second
        set the content of ClientStatus to ``
        set style `display` of ClientOverlay to `none`
        return
    end

    set style `color` of ClientStatus to `#c00`
    if ClientSaveStatus is not empty
        set the content of ClientStatus to `Save failed: ` cat ClientSaveStatus
    else if SessionState is `expired`
        set the content of ClientStatus to `Save failed — session expired, please sign in again.`
    else if SessionState is `valid`
        set the content of ClientStatus to `Save failed — the server rejected the save.`
    else
        set the content of ClientStatus to `Save failed — could not reach server.`
    return

BuildClientsBody:
    put `{"clients":[` into ClientBody
    put 0 into I
    while I is less than ClientCount
    begin
        if I is greater than 0
            put ClientBody cat `,` into ClientBody
        put ClientBody cat `{"company":"` into ClientBody
        put element I of ClientCompanies into TempStr2
        gosub AppendClientString
        put ClientBody cat `","rep":"` into ClientBody
        put element I of ClientReps into TempStr2
        gosub AppendClientString
        put ClientBody cat `","phone":"` into ClientBody
        put element I of ClientPhones into TempStr2
        gosub AppendClientString
        put ClientBody cat `","email":"` into ClientBody
        put element I of ClientEmails into TempStr2
        gosub AppendClientString
        put ClientBody cat `"}` into ClientBody
        add 1 to I
    end
    put ClientBody cat `],"renames":[` into ClientBody
    put 0 into I
    put 0 into ClientRenameCount
    while I is less than ClientCount
    begin
        put element I of ClientOrigCompanies into ClientFromCompany
        put element I of ClientOrigReps into ClientFromRep
        put element I of ClientCompanies into ClientToCompany
        put element I of ClientReps into ClientToRep
        put 0 into ClientKeyB
        if ClientFromCompany is not empty
            put 1 into ClientKeyB
        if ClientFromRep is not empty
            put 1 into ClientKeyB
        put 0 into ClientKeyA
        if ClientFromCompany is not ClientToCompany
            put 1 into ClientKeyA
        if ClientFromRep is not ClientToRep
            put 1 into ClientKeyA
        if ClientKeyA is 1 and ClientKeyB is 1
        begin
            if ClientRenameCount is greater than 0
                put ClientBody cat `,` into ClientBody
            add 1 to ClientRenameCount
            put ClientBody cat `{"old_company":"` into ClientBody
            put ClientFromCompany into TempStr2
            gosub AppendClientString
            put ClientBody cat `","old_rep":"` into ClientBody
            put ClientFromRep into TempStr2
            gosub AppendClientString
            put ClientBody cat `","company":"` into ClientBody
            put ClientToCompany into TempStr2
            gosub AppendClientString
            put ClientBody cat `","rep":"` into ClientBody
            put ClientToRep into TempStr2
            gosub AppendClientString
            put ClientBody cat `"}` into ClientBody

            ! Keep the booking being edited in step with a renamed client.
            put the content of ClientInput into ClientCompare
            put trim ClientCompare into ClientCompare
            put lowercase ClientCompare into ClientCompare
            put trim ClientFromCompany into TempStr
            put lowercase TempStr into TempStr
            if ClientCompare is TempStr
            begin
                put the content of ContactInput into ClientMeta
                put trim ClientMeta into ClientMeta
                put lowercase ClientMeta into ClientMeta
                put trim ClientFromRep into TempStr
                put lowercase TempStr into TempStr
                if ClientMeta is TempStr
                begin
                    set the content of ClientInput to ClientToCompany
                    set the content of ContactInput to ClientToRep
                end
            end
        end
        add 1 to I
    end
    put ClientBody cat `]}` into ClientBody
    return

SaveClientData:
    gosub BuildClientsBody
    gosub PostClients
    if ClientSaveFailed is not empty
    begin
        gosub CheckSession
        if SessionState is `expired`
        begin
            gosub RecoverSession
            if SessionRecovered is not empty
                gosub PostClients
        end
    end
    return

PostClients:
    put `` into ClientSaveStatus
    put `` into ClientSaveFailed
    put 0 into ClientRenamed
    rest post ClientBody to `clients.php` giving ClientResponseJson on failure
    begin
        put `yes` into ClientSaveFailed
        return
    end
    put json ClientResponseJson into ClientResponseObj
    put property `status` of ClientResponseObj into ClientSaveStatus
    put property `renamed` of ClientResponseObj into ClientRenamed
    return

AppendClientString:
    gosub EscapeJson
    put ClientBody cat TempStr2 into ClientBody
    return
!! @hash 75354d6a
!!!
!! OnSave: read form fields, build a JSON record, POST to bookings-save.php.
OnSave:
    set the content of ModalStatus to `Saving...`

    ! Always rebuild slug from current date + name, so a name change updates it
    ! on re-save.  When editing, derive the on-disk slug from the file path
    ! (EditPath, the actual filename) rather than from the slug field in the JSON
    ! content — a previous partial save may have updated the content slug without
    ! renaming the file, and comparing against the filename catches that mismatch.
    if IsCreate is 0
    begin
        put the position of the last `/` in EditPath into TempNum
        add 1 to TempNum
        put from TempNum of EditPath into TempStr2
        put the position of `.` in TempStr2 into TempNum
        if TempNum is not -1
            put left TempNum of TempStr2 into OldSlug
        else
            put TempStr2 into OldSlug
    end
    put the content of DateInput into BookingDate
    put the content of NameInput into BookingName
    gosub MakeSlug
    put TempStr into EditSlugOld
    if IsCreate is 0
    begin
        if EditSlugOld is not OldSlug
            put EditPath into SlugChanged
        else
            put `` into SlugChanged
    end

    !! Auto-fill mileage: if Mileage is 0 but Distance is set, double Distance for return trip
    put the content of MileageInput into TempStr
    if TempStr is `0`
    begin
        put the content of DistanceInput into TempStr
        if TempStr is not empty
        begin
            put the value of TempStr into TempNum
            multiply TempNum by 2
            put TempNum cat `.0` into TempStr
            set the content of MileageInput to TempStr
        end
    end

    !! Auto-fill expense: if Expense is 0.00 and Mileage is set, compute Mileage * 0.45
    put the content of ExpenseInput into TempStr
    if TempStr is `0.00`
    begin
        put the content of MileageInput into TempStr
        if TempStr is not `0` and TempStr is not empty
        begin
            put the value of TempStr into TempNum
            multiply TempNum by 45
            ! TempNum is now mileage * 45 (pence)
            divide TempNum by 100 giving ExpensePounds
            put TempNum modulo 100 into ExpensePence
            put ExpensePounds cat `.` into TempStr
            if ExpensePence is less than 10
                put TempStr cat `0` cat ExpensePence into TempStr
            else
                put TempStr cat ExpensePence into TempStr
            set the content of ExpenseInput to TempStr
        end
    end

    ! Start building the record
    put `{` into BodyText
    gosub JsonAddString with `slug`
    put BodyText cat `,` into BodyText
    gosub JsonAddString with `kind`
    ! Read paid boolean from checkbox
    put attribute `checked` of PaidInput into TempStr
    if TempStr is not empty
        put true into Paid
    else
        put false into Paid
    put BodyText cat `,"paid":` cat Paid into BodyText
    put BodyText cat `,` into BodyText
    gosub JsonAddString with `date`
    put BodyText cat `,` into BodyText
    gosub JsonAddString with `time`
    put BodyText cat `,` into BodyText
    gosub JsonAddString with `name`
    put BodyText cat `,` into BodyText
    gosub JsonAddString with `location`
    put BodyText cat `,` into BodyText
    gosub JsonAddString with `postcode`
    put BodyText cat `,` into BodyText
    gosub JsonAddString with `distance`
    put BodyText cat `,` into BodyText
    gosub JsonAddString with `contact`
    put BodyText cat `,` into BodyText
    gosub JsonAddString with `client`
    put BodyText cat `,` into BodyText
    gosub JsonAddString with `client_email`
    put BodyText cat `,` into BodyText
    gosub JsonAddString with `client_phone`
    put BodyText cat `,` into BodyText
    gosub JsonAddString with `dacast_id`
    put BodyText cat `,` into BodyText
    gosub JsonAddString with `stream_url`
    put BodyText cat `,` into BodyText
    gosub JsonAddString with `recording_url`
    put BodyText cat `,` into BodyText
    gosub JsonAddNumber with `mileage`
    put BodyText cat `,` into BodyText
    gosub JsonAddNumber with `expense`
    put BodyText cat `,` into BodyText
    gosub JsonAddNumber with `fees`
    put BodyText cat `,` into BodyText
    gosub JsonAddString with `linkSent`
    put BodyText cat `,` into BodyText
    gosub JsonAddString with `invoiced`
    put BodyText cat `,` into BodyText
    gosub JsonAddString with `paidDate`
    put BodyText cat `,` into BodyText
    gosub JsonAddString with `title`
    put BodyText cat `,` into BodyText
    gosub JsonAddString with `contact_name`
    put BodyText cat `,` into BodyText
    gosub JsonAddString with `contact_relation`
    put BodyText cat `,` into BodyText
    gosub JsonAddString with `contact_telephone`
    put BodyText cat `,` into BodyText
    gosub JsonAddString with `contact_email`
    put BodyText cat `,` into BodyText
    gosub JsonAddString with `recording_text`
    put BodyText cat `,` into BodyText
    gosub JsonAddString with `notes`
    put BodyText cat `,` into BodyText
    gosub JsonAddString with `tribute_url`
    put BodyText cat `,` into BodyText
    gosub JsonAddString with `document_url`
    if SlugChanged is not empty
    begin
        put BodyText cat `,"old_path":"` cat SlugChanged cat `"` into BodyText
    end
    put BodyText cat `}` into BodyText

    gosub PostSave

    ! Every non-2xx reply reaches the runtime as one undifferentiated failure,
    ! so a failed save has to be diagnosed before it can be described. Ask the
    ! server whether this session is still valid: if it expired while the tab
    ! sat idle, sign in again from the credentials already in the login fields
    ! and retry the save, so a long-idle tab quietly carries on working.
    if SaveFailed is not empty
    begin
        gosub CheckSession
        if SessionState is `expired`
        begin
            gosub RecoverSession
            if SessionRecovered is not empty
                gosub PostSave
        end
    end

    if SaveStatus is `ok`
    begin
        set the content of ModalStatus to `Saved ✓`
        wait 3 seconds
        set the content of ModalStatus to ``
        set style `display` of Overlay to `none`
        set style `display` of LocationOverlay to `none`
        set style `display` of LocationEditOverlay to `none`
        put 0 into LocationsLoaded
        set style `display` of ClientOverlay to `none`
        set style `display` of ClientEditOverlay to `none`
        put 0 into ClientsLoaded
        gosub Refresh
        return
    end

    if SaveStatus is not empty
        set the content of ModalStatus to `Save failed: ` cat SaveStatus
    else if SessionState is `expired`
        set the content of ModalStatus to `Save failed — session expired, please sign in again.`
    else if SessionState is `valid`
        set the content of ModalStatus to `Save failed — the server rejected the save.`
    else
        set the content of ModalStatus to `Save failed — could not reach server.`
    wait 3 seconds
    set the content of ModalStatus to ``
    return
!! @hash dc7a447a
!!!
!! PostSave: POST the assembled record and report the outcome.
!!
!! Split out of OnSave because a save may legitimately be attempted twice: once with the session the page was loaded with, then again after that session has been re-created. SaveStatus carries the response's own status field; when the request never got a 2xx reply SaveStatus is left empty and SaveFailed is set, leaving the caller to work out why.
PostSave:
    put `` into SaveStatus
    put `` into SaveFailed
    rest post BodyText to `bookings-save.php` giving ResponseJson on failure
    begin
        put `yes` into SaveFailed
        return
    end
    put json ResponseJson into ResponseObj
    put property `status` of ResponseObj into SaveStatus
    return
!! @hash c4ffd2c5
!!!

!! CheckSession: ask the server whether this session is still valid.
!!
!! An expired session and an unreachable server look identical from a failed POST — the runtime reports any non-2xx as the same undifferentiated failure and discards the body. The heartbeat endpoint always answers when it can be reached, so a reply settles it: `authenticated: no` means the session went away while the tab sat idle, while no reply at all means the network. Sets SessionState to `valid`, `expired` or `unreachable`.
CheckSession:
    put `unreachable` into SessionState
    rest get HeartbeatJson from `heartbeat.php` on failure
    begin
        return
    end
    put json HeartbeatJson into HeartbeatObj
    put property `authenticated` of HeartbeatObj into TempStr
    if TempStr is `yes`
        put `valid` into SessionState
    else
        put `expired` into SessionState
    return
!! @hash 39917b80
!!!

!! RecoverSession: sign in again after the session expired, without troubling the user.
!!
!! The login fields still hold the credentials the page was loaded with, so repeating the login POST re-creates the session and the caller can retry the write that failed. Restoring the login panel on failure is the one case the user has to know about, because the credentials are no longer good.
RecoverSession:
    put `` into SessionRecovered
    gosub BuildLoginBody
    rest post LoginBody to `login.php` giving ResponseJson on failure
    begin
        return
    end
    put json ResponseJson into ResponseObj
    put property `status` of ResponseObj into ResponseStatus
    if ResponseStatus is not `ok`
    begin
        set the content of LoginStatus to `Login failed — please sign in again.`
        set style `display` of LoginPanel to `block`
        return
    end
    put `yes` into SessionRecovered
    return
!! @hash 159be724
!!!

!! BuildLoginBody: compose the login POST body from the login fields.
!!
!! Shared by OnLogin and RecoverSession. It writes to LoginBody rather than BodyText for a reason: mid-save, BodyText is holding the record that is about to be re-posted, and the retry depends on it surviving the recovery intact.
BuildLoginBody:
    put `{"user":"` cat the content of UserField into LoginBody
    put LoginBody cat `","pass":"` cat the content of PassField into LoginBody
    put LoginBody cat `"}` into LoginBody
    return
!! @hash d85a4629
!!!

!! OnLinkSentToggle: when the toggle changes, set or clear the linkSent date.
OnLinkSentToggle:
    put attribute `checked` of LinkSentToggle into TempStr
    if TempStr is not empty
    begin
        gosub TodayString
        set the content of LinkSentInput to TodayStr
    end
    else
        set the content of LinkSentInput to ``
    return
!! @hash ad985367
!!!
!! OnInvoicedToggle: when the toggle changes, set or clear the invoiced date.
OnInvoicedToggle:
    put attribute `checked` of InvoicedToggle into TempStr
    if TempStr is not empty
    begin
        gosub TodayString
        set the content of InvoicedInput to TodayStr
    end
    else
        set the content of InvoicedInput to ``
    return
!! @hash 6b440dcf
!!!
!! OnPaidToggle: when the paid checkbox changes, set or clear the paidDate.
OnPaidToggle:
    put attribute `checked` of PaidInput into TempStr
    if TempStr is not empty
    begin
        gosub TodayString
        set the content of PaidDateInput to TodayStr
    end
    else
        set the content of PaidDateInput to ``
    return
!! @hash 9ccbf75d
!!!
!! OnOpenStream: build the stream URL from form data and navigate there.
OnOpenStream:
    put the content of DateInput into BookingDate
    put the content of NameInput into BookingName
    gosub MakeSlug
    put `https://stream.eclecity.net/` cat TempStr into TargetUrl
    location TargetUrl
    return
!! @hash 09e5e7e9
!!!
!! OnOpenRecordingUrl: navigate to the recording URL in the current tab.
OnOpenRecordingUrl:
    put the content of RecordingUrlInput into TargetUrl
    if TargetUrl is not empty
        location TargetUrl
    return
!! @hash a48f14ed
!!!
!! OnOpenTributeUrl: navigate to the tribute video URL in the current tab.
OnOpenTributeUrl:
    put the content of TributeUrlInput into TargetUrl
    if TargetUrl is not empty
        location TargetUrl
    return
!! @hash 0d91077e
!!!
!! OnOpenDocumentUrl: navigate to the document URL in the current tab.
OnOpenDocumentUrl:
    put the content of DocumentUrlInput into TargetUrl
    if TargetUrl is not empty
        location TargetUrl
    return
!! @hash 765edc40
!!!
!! OnUploadDocument: open the upload page in a new tab, pre-filled with the date and a filename built from the date, time and description.
OnUploadDocument:
    put the content of DateInput into BookingDate
    put the content of NameInput into BookingName
    gosub BuildUploadFileName
    ! UploadFileName is already URL-safe, so it drops straight into the query string.
    put `/upload.php?date=` cat BookingDate cat `&name=` cat UploadFileName into DocumentUpPath
    location DocumentUpPath
    return
!! @hash eb20dfd4
!!!
!! BuildUploadFileName: compose the upload filename from the date, time and description already in the form.
!!
!! The result reads YYMMDD-HHMM-Description, e.g. `260911-1430-Streaming-license`. Date and time are optional, so a half-filled form still yields a usable name. Only letters and digits survive, spaces become hyphens, and everything else is dropped — the same cleaning MakeSlug applies, which is what makes the value safe to put straight into the upload URL's query string without percent-encoding.
BuildUploadFileName:
    put `` into UploadFileName

    if BookingDate is not empty
        ! BookingDate is YYYY-MM-DD; take YY MM DD by position.
        put from 2 of BookingDate into TempStr
        put left 2 of TempStr into YYStr
        put from 5 of BookingDate into TempStr
        put left 2 of TempStr into Mo
        put from 8 of BookingDate into TempStr
        put left 2 of TempStr into Dd
        put YYStr cat Mo cat Dd into UploadFileName

    put the content of TimeInput into TempStr2
    if TempStr2 is not empty and UploadFileName is not empty
        ! TimeInput is HH:MM; keep just the hours and the minutes.
        put left 2 of TempStr2 into HhStr
        put from 3 of TempStr2 into MmStr
        put left 2 of MmStr into MmStr
        put UploadFileName cat `-` cat HhStr cat MmStr into UploadFileName

    ! Clean the description into TempStr: keep alnum, spaces become hyphens.
    put `` into TempStr
    put BookingName into TempStr2
    put the length of TempStr2 into SortK
    put 0 into J
    while J is less than SortK
    begin
        put char J of TempStr2 into Ch
        if Ch is not less than `A` and Ch is not greater than `Z`
            put TempStr cat Ch into TempStr
        else if Ch is not less than `a` and Ch is not greater than `z`
            put TempStr cat Ch into TempStr
        else if Ch is not less than `0` and Ch is not greater than `9`
            put TempStr cat Ch into TempStr
        else if Ch is ` `
            put TempStr cat `-` into TempStr
        add 1 to J
    end

    if TempStr is not empty
        if UploadFileName is not empty
            put UploadFileName cat `-` into UploadFileName
        put UploadFileName cat TempStr into UploadFileName
    return
!! @hash e4e491fe
!!!
!! WatchForUploadedDocument: poll browser storage for a document path handed over by the upload page.
!!
!! The upload page is a separate document and cannot touch this form directly, so it leaves the path in storage and this forked thread collects it. Polling means the hand-over lands whether the admin page was restored from the browser's back/forward cache or reloaded from scratch. The key is cleared on pickup, so a path is collected once.
WatchForUploadedDocument:
    while true
    begin
        wait 1 second
        get UploadedDocUrl from storage as `stream.pendingDocumentUrl`
        if UploadedDocUrl is not empty
        begin
            set the content of DocumentUrlInput to UploadedDocUrl
            remove attribute `disabled` of DocumentUrlBtn
            put `` into storage as `stream.pendingDocumentUrl`
        end
    end
!! @hash 89553489
!!!
!! Heartbeat: keep the server-side session alive while the page stays open.
!!
!! PHP collects a session that has gone unwritten for session.gc_maxlifetime — 24 minutes by default — and the admin tab makes no requests at all while it sits idle. Left open over lunch, it comes back to a session the server has forgotten, and the next save is refused. This forked thread stamps the session every ten minutes, comfortably inside that window, so the tab stays loadable however long it is left open.
!!
!! The ping shares the endpoint the save path uses to tell an expired session from an unreachable server (see CheckSession), which is why the reply is fetched rather than discarded. A failed ping is ignored: a single blip must not kill the heartbeat for the rest of the page's life, and the save path re-checks when it matters.
Heartbeat:
    while true
    begin
        wait 10 minutes
        rest get PingJson from `heartbeat.php` on failure set PingJson to ``
    end
!! @hash eb197cb0
!!!

!! OnDocumentUrlChanged: keep the View button in step with the Document field.
!!
!! Previously the button only recalculated when the form was populated, so it could sit inactive after a URL had been typed or pasted in.
OnDocumentUrlChanged:
    if the content of DocumentUrlInput is not empty
        remove attribute `disabled` of DocumentUrlBtn
    else
        set attribute `disabled` of DocumentUrlBtn to `disabled`
    return
!! @hash de8f0716
!!!
!! OnEmail1: fetch email template, substitute record data, build mailto: URI,
!! and open in the default email client.
OnEmail1:
    set the content of ModalStatus to `Loading template...`
    rest get EmailTemplate from `/email1.json` or begin
        set the content of ModalStatus to `Could not load email template.`
        wait 3 seconds
        set the content of ModalStatus to ``
        return
    end

    ! Build stream URL from form fields
    put the content of DateInput into BookingDate
    put the content of NameInput into BookingName
    gosub MakeSlug
    put `https://stream.eclecity.net/` cat TempStr into StreamUrl

    ! Read form fields into temp variables
    put the content of ContactEmailInput into ContactEmailVal
    put the content of ClientEmailInput into ClientEmailVal
    put the content of NameInput into NameVal
    put the content of LocationInput into LocationVal
    put the content of DateInput into DateVal
    put the content of TimeInput into TimeVal
    put the content of ContactNameInput into ContactNameVal
    put the content of ContactRelationInput into ContactRelationVal
    put the content of ContactInput into ClientRepVal
    put the content of ClientInput into ClientCompanyVal

    ! --- To field ---
    put property `to` of EmailTemplate into ToField
    replace `[CONTACT EMAIL]` with ContactEmailVal in ToField

    ! --- CC field ---
    put property `cc` of EmailTemplate into CcField
    replace `[CLIENT EMAIL]` with ClientEmailVal in CcField

    ! --- Subject field ---
    put property `subject` of EmailTemplate into SubjectField
    replace `[DECEASED]` with NameVal in SubjectField
    replace `[LOCATION]` with LocationVal in SubjectField
    replace `[DATE]` with DateVal in SubjectField
    replace `[TIME]` with TimeVal in SubjectField
    ! URL-encode the subject
    replace `%` with `%25` in SubjectField
    replace `&` with `%26` in SubjectField
    replace `"` with `%22` in SubjectField

    ! --- Body: build from body_parts array with %0A between parts ---
    put property `body_parts` of EmailTemplate into BodyParts
    put json count of BodyParts into PartCount
    put `` into BodyField
    put 0 into J
    while J is less than PartCount
    begin
        if J is greater than 0
            put BodyField cat `%0A` into BodyField
        put item J of BodyParts into PartText
        replace `[CONTACT EMAIL]` with ContactEmailVal in PartText
        replace `[CLIENT EMAIL]` with ClientEmailVal in PartText
        replace `[DECEASED]` with NameVal in PartText
        replace `[LOCATION]` with LocationVal in PartText
        replace `[DATE]` with DateVal in PartText
        replace `[TIME]` with TimeVal in PartText
        replace `[CONTACT]` with ContactNameVal in PartText
        replace `[RELATION]` with ContactRelationVal in PartText
        replace `[CLIENT REP]` with ClientRepVal in PartText
        replace `[CLIENT COMPANY]` with ClientCompanyVal in PartText
        replace `[STREAM]` with StreamUrl in PartText
        ! URL-encode this line
        replace `%` with `%25` in PartText
        replace `&` with `%26` in PartText
        replace `"` with `%22` in PartText
        put BodyField cat PartText into BodyField
        add 1 to J
    end

    ! Build mailto: URI (only include cc if not empty)
    put `mailto:` cat ToField into MailToUri
    if CcField is not empty
    begin
        put MailToUri cat `?cc=` cat CcField into MailToUri
        put MailToUri cat `&subject=` cat SubjectField into MailToUri
    end
    else
        put MailToUri cat `?subject=` cat SubjectField into MailToUri
    put MailToUri cat `&body=` cat BodyField into MailToUri
    location MailToUri
    set the content of ModalStatus to ``
    return
!! @hash d509288f
