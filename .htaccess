# stream.eclecity.net — URL routing for the AllSpeak front end.
# The .allspeak / .json / .php / .html files are served directly when
# requested by name. The two named endpoints below are rewritten
# to their underlying .html launchers.

RewriteEngine On

# Layout and script files are rebuilt on every deploy. DreamHost's default is a
# two-day cache, which lets a browser pair a new script with an old layout (or
# the reverse) after an update — force revalidation instead.
<IfModule mod_headers.c>
    <FilesMatch "\.(json|allspeak)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# Serve real files and directories as-is
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# /admin -> redirect to / (admin now lives at root)
RewriteRule ^admin/?$ / [R=302,L]

# /{slug} -> single-stream viewer
# Slugs always start with a digit (YYMMDD-...)
RewriteRule ^[0-9][^/]*/?$ stream.html [L]
